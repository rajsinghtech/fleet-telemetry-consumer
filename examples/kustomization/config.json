{
  "host": "0.0.0.0",
  "port": 8443,
  "status_port": 8080,
  "log_level": "debug",
  "json_log_enable": true,
  "namespace": "tesla",
  "reliable_ack": true,
  "monitoring": {
    "prometheus_metrics_port": 9273,
    "profiler_port": 4269,
    "profiling_path": "/tmp/trace.out"
  },
  "records": {
    "alerts": ["logger"],
    "errors": ["logger"],
    "V": ["logger", "kafka"]
  },
  "tls": {
    "server_cert": "/etc/ssl/certs/tls.crt",
    "server_key": "/etc/ssl/certs/tls.key"
  },
  "kafka": {
    "bootstrap.servers": "tesla-kafka-brokers.tesla.svc.cluster.local:9092",
    "queue.buffering.max.messages": 1000000
  }
}